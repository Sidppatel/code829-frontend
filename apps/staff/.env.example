# Staff app Vite env — copy to `.env.local` (gitignored) to override locally.
# All VITE_* values are baked into the client bundle at build time — never put secrets here.
#
# Feature flags (see packages/shared/src/lib/featureFlags.ts):
#   VITE_USE_NEW_SHELL — defaults to "true"; set to "false" to opt out of the new shell.
# VITE_USE_NEW_SHELL=false
