{
  "name": "code829-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:public": "pnpm --filter @code829/public dev",
    "dev:admin": "pnpm --filter @code829/admin dev",
    "dev:staff": "pnpm --filter @code829/staff dev",
    "dev:developer": "pnpm --filter @code829/developer dev",
    "build": "pnpm -r build",
    "build:public": "pnpm --filter @code829/public build",
    "build:admin": "pnpm --filter @code829/admin build",
    "build:staff": "pnpm --filter @code829/staff build",
    "build:developer": "pnpm --filter @code829/developer build",
    "lint": "pnpm -r lint",
    "preview:public": "pnpm --filter @code829/public preview",
    "preview:admin": "pnpm --filter @code829/admin preview",
    "preview:staff": "pnpm --filter @code829/staff preview",
    "preview:developer": "pnpm --filter @code829/developer preview",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "gen:tokens": "tsx scripts/gen-tokens-json.ts",
    "gen:types": "openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi/v1.json} -o packages/shared/src/types/generated/api.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.0",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "wrangler": "4.108.0"
  },
  "resolutions": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.0",
    "react-router-dom": "7.15.0"
  },
  "overrides": {
    "react-router": "7.15.0",
    "react-router-dom": "7.15.0"
  }
}
